{
  "name": "single-page-express",
  "description": "📄 A client-side implementation of the Express route API.",
  "author": "Roosevelt Framework Team <rooseveltframework@gmail.com>",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/rooseveltframework/single-page-express/graphs/contributors"
    }
  ],
  "version": "2.2.0",
  "files": [
    "dist",
    "*.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/single-page-express.mjs",
      "require": "./dist/single-page-express.cjs"
    },
    "./min": {
      "default": "./dist/single-page-express.min.mjs"
    }
  },
  "homepage": "https://rooseveltframework.org/docs/single-page-express/latest",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "single-page-express.js",
  "dependencies": {
    "path-to-regexp": "8.4.2",
    "path-to-regexp-express4": "npm:path-to-regexp@0.1.13",
    "topbar": "3.0.1"
  },
  "devDependencies": {
    "express": "5.2.1",
    "html-validate": "11.16.1",
    "playwright": "1.63.0",
    "standard": "17.1.2",
    "teddy": "2.0.4",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "scripts": {
    "build": "webpack",
    "sample-app-basic-frontend-only": "node scripts/serve-sample-app.js basicFrontendOnly",
    "sample1": "node --run sample-app-basic-frontend-only",
    "sample-app-basic-frontend-only-with-templating": "node scripts/serve-sample-app.js basicFrontendOnlyWithTemplating",
    "sample2": "node --run sample-app-basic-frontend-only-with-templating",
    "express-sample": "cd sampleApps/express && node server.js",
    "sample3": "node --run express-sample",
    "express-complex": "cd sampleApps/express-complex && node server.js",
    "sample4": "node --run express-complex",
    "lint": "standard",
    "lint-fix": "standard --fix",
    "test": "node --run build && node --test",
    "coverage": "node --run build && node --test --experimental-test-coverage"
  },
  "standard": {
    "ignore": [
      "dist/",
      "sampleApps/express/public",
      "sampleApps/express-complex/public"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rooseveltframework/single-page-express.git"
  },
  "keywords": [
    "single page app",
    "SPA",
    "SPE",
    "express",
    "express.js",
    "router",
    "frontend router"
  ],
  "funding": "https://www.paypal.com/donate/?hosted_button_id=2L2X8GRXZCGJ6"
}
